# Client ID from https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# Optional. Defaults to <current origin>/callback, so you normally don't need it.
# It must exactly match a redirect URI registered in the Spotify dashboard.
# Spotify rejects "localhost"; use the loopback IP for local development.
# VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
